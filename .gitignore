# Producción / Builds
/dist
/build
/.next
/out
/*.zip

# Archivos de log
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Variables de entorno
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# Archivos de sistema operativo
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.iml

# Cache de dependencias
.eslintcache
/.cache
/package-lock.json? # Si usas npm, puedes comentar esta línea para incluir el lockfile
/yarn.lock?          # Si usas yarn, comenta esta línea para incluir el lockfile
/pnpm-lock.yaml?     # Similar con pnpm

# Archivos temporales
*.tmp
*.temp
*.bak

# Tests / Cobertura
/coverage
.nyc_output

# Next.js específico
.next/
out/
.vercel
vercel.json?  # si quieres ignorar configuración de Vercel (opcional)

